<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayTraffic.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Tray Traffic">

    <Grid x:Name="PopupRoot" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentPresenter x:Name="PageHost" Grid.Row="1" />
    </Grid>
</ex:WindowEx>
