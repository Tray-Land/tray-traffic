<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayTraffic.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TrayTraffic.Views"
    Background="Transparent">
    <Page.Resources>
        <Storyboard x:Name="SkeletonPulse" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="SkeletonRows"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0.4"
                Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>
    <Grid Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="HeaderGrid" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderTitle" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Tray Traffic" />
            <!-- The window modes move these into the title bar. -->
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <ToggleButton
                x:Name="RouteToggle"
                AutomationProperties.AutomationId="RouteToggle"
                AutomationProperties.Name="Show driving routes"
                Content="Route"
                IsChecked="False"
                ToolTipService.ToolTip="Show trip controls, driving routes, and directions." />
            <Button
                x:Name="RefreshButton"
                AutomationProperties.Name="Refresh traffic"
                Click="RefreshButton_Click"
                IsEnabled="False"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Refresh traffic"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="SettingsButton"
                AutomationProperties.Name="Places and settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Places and settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="WindowOptionsButton"
                AutomationProperties.Name="Window options"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Window options">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="WindowOptions_Opening">
                        <RadioMenuFlyoutItem x:Name="FlyoutModeItem" GroupName="WindowMode" Text="Flyout" Click="WindowMode_Click" Tag="Flyout" />
                        <RadioMenuFlyoutItem x:Name="WindowModeItem" GroupName="WindowMode" Text="Window" Click="WindowMode_Click" Tag="Window" />
                        <RadioMenuFlyoutItem x:Name="AlwaysOnTopModeItem" GroupName="WindowMode" Text="Always on top" Click="WindowMode_Click" Tag="AlwaysOnTop" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="ResizeItem" Text="Resize" Click="ResizeItem_Click" />
                        <ToggleMenuFlyoutItem x:Name="RememberItem" Text="Remember size &amp; position" Click="RememberItem_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            </StackPanel>
        </Grid>
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Margin="{x:Bind views:FlyoutPage.StatusMargin(StatusBar.IsOpen), Mode=OneWay}"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />
        <Grid Grid.Row="2">
            <Grid x:Name="TripPicker" Margin="0,8,0,0" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="FromPicker"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Starting place"
                    IsEnabled="False"
                    PlaceholderText="From"
                    SelectionChanged="Place_SelectionChanged" />
                <!-- Points the way the trip goes; clicking reverses it. -->
                <Button
                    x:Name="SwapButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Swap starting place and destination"
                    Click="SwapButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    ToolTipService.ToolTip="Reverse this trip">
                    <FontIcon FontSize="16" Glyph="&#xE72A;" />
                </Button>
                <ComboBox
                    x:Name="ToPicker"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Destination"
                    IsEnabled="False"
                    PlaceholderText="To"
                    SelectionChanged="Place_SelectionChanged" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search for a place to go"
                    Click="SearchButton_Click"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    ToolTipService.ToolTip="Search for any place to go">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </Button>
            </Grid>
            <Grid x:Name="PlaceSearch" Margin="0,8,0,0" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="PlaceSearchBox"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search for a place to go"
                    MaxSuggestionListHeight="320"
                    PlaceholderText="Search places and addresses"
                    QueryIcon="Find"
                    QuerySubmitted="PlaceSearchBox_QuerySubmitted"
                    TextChanged="PlaceSearchBox_TextChanged"
                    TextMemberPath="Name">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="views:PlaceResultItem">
                            <StackPanel Padding="0,6" Spacing="2" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <Button
                    x:Name="CloseSearchButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Close place search"
                    Click="CloseSearchButton_Click"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    ToolTipService.ToolTip="Close search">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Border
                x:Name="MapPlaceholder"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25" />
                </Border.OpacityTransition>
                <ProgressRing x:Name="MapLoadingRing" Width="32" Height="32" AutomationProperties.Name="Loading the map" IsActive="False" />
            </Border>
            <ContentControl x:Name="MapHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Opacity="0">
                <ContentControl.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.3" />
                </ContentControl.OpacityTransition>
            </ContentControl>
        </Grid>
        <StackPanel x:Name="EmptyState" Grid.Row="3" Grid.RowSpan="4" Margin="20" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
            <FontIcon FontSize="56" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE804;" />
            <TextBlock
                x:Name="EmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Your everyday routes"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="EmptyDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Save home, work, and school, then see live traffic and the quickest way to get there."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="SetupButton"
                HorizontalAlignment="Center"
                Click="SettingsButton_Click"
                Content="Set up my routes"
                Style="{StaticResource AccentButtonStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Free TomTom tier. Traffic updates only while this is open, or for leave reminders you turn on."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid x:Name="RouteHeading" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RecommendationText" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button
                x:Name="DirectionsButton"
                Grid.Column="1"
                AutomationProperties.Name="Open directions in Google Maps"
                Click="DirectionsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Open Google Maps. It will calculate its own route.">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
            </Button>
        </Grid>
        <Grid x:Name="RoutesArea" Grid.Row="5" Margin="0,8,0,0" Visibility="Collapsed">
            <ListView
                x:Name="RoutesList"
                MaxHeight="180"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Driving route recommendations"
                Opacity="0"
                SelectionChanged="RoutesList_SelectionChanged"
                SelectionMode="Single">
                <ListView.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25" />
                </ListView.OpacityTransition>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:RouteItem">
                        <Grid Padding="0,8" ColumnSpacing="8" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Duration, Mode=OneTime}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Stand-in rows shaped like route items, as many as the last result, while routes load. -->
            <Grid
                x:Name="RouteSkeleton"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Opacity="0">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25" />
                </Grid.OpacityTransition>
                <ItemsControl x:Name="SkeletonRows" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="54" Margin="4,2" Padding="12,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <Border Width="112" Height="12" HorizontalAlignment="Left" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" CornerRadius="4" />
                                    <Border Width="176" Height="10" HorizontalAlignment="Left" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" CornerRadius="4" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="56" Height="18" VerticalAlignment="Center" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" CornerRadius="4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
        <TextBlock
            x:Name="MapNotice"
            Grid.Row="6"
            Margin="0,8,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <TextBlock
                x:Name="UpdatedText"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Live traffic by TomTom"
                TextWrapping="Wrap" />
            <ProgressRing x:Name="LoadingRing" Width="16" Height="16" MinWidth="16" MinHeight="16" HorizontalAlignment="Right" AutomationProperties.Name="Updating traffic" IsActive="False" />
        </Grid>
    </Grid>
</Page>
